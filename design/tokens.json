{
  "name": "Blueprint",
  "version": "1.0",
  "slide": { "widthIn": 13.333, "heightIn": 7.5, "widthPx": 1920, "heightPx": 1080, "pxPerIn": 144, "pxPerPt": 2 },
  "margin": { "x": 100, "top": 72, "bottom": 52, "titleGap": 28, "contentGap": 56 },
  "font": {
    "latin": ["Helvetica Neue", "Segoe UI", "Arial"],
    "cjk": ["PingFang TC", "Microsoft JhengHei"],
    "numerals": "tabular"
  },
  "type": {
    "display": { "px": 104, "weight": 600 },
    "statement": { "px": 88, "weight": 600 },
    "number": { "px": 120, "weight": 300 },
    "title": { "px": 56, "weight": 600 },
    "sub": { "px": 36, "weight": 400 },
    "body": { "px": 32, "weight": 400 },
    "label": { "px": 24, "weight": 400 }
  },
  "stroke": { "grid": 1, "axis": 1, "focusRule": 4, "focusLine": 3, "otherLine": 1.5, "tickLong": 14, "tickShort": 7, "axisTick": 8 },
  "color": {
    "text": "#111111", "textSecondary": "#4A4A4A", "grid": "#DDDDDD", "gray": "#7F7F7F",
    "title": "#00315A", "dark": "#023560", "onDark": ["#FFFFFF", "#B5CFEC"], "tint": "#E8EFF7",
    "focus": "#125A98",
    "ordered": ["#8AAFD6", "#6898C9", "#4B83BB", "#2F6DAA", "#125A98"],
    "categorical": ["#125A98", "#9B482F", "#B58A26", "#976DA9"],
    "other": "#B3B3B3",
    "better": "#125A98",
    "worse": "#9B482F",
    "signs": { "increase": "＋", "decrease": "−" }
  },
  "series": {
    "better": { "values": ["higher", "lower"], "default": "higher", "rule": "符號照實寫；變好用 color.better，變差用 color.worse" }
  },
  "pattern": {
    "estimate": { "angle": 45, "stroke": "#125A98", "width": 1.5, "spacing": 7, "outline": "#125A98" },
    "other": { "angle": 45, "stroke": "#B3B3B3", "width": 2, "spacing": 7 }
  }
}
